#!/usr/bin/env sh
# Pre-commit secret scan. Catches credentials before they leave the laptop;
# GitHub's server-side secret scanning and push protection are the backstop.
# Optional: a missing gitleaks prints a notice and skips rather than blocking,
# so environments without it (CI sandboxes, agent containers) can commit
# without --no-verify. An installed gitleaks that finds something still
# blocks. See README.md "Pre-commit secret scan" for setup.

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner --config .gitleaks.toml
else
  echo "pre-commit: gitleaks not found in PATH; skipping secret scan (\`brew install gitleaks\`)." >&2
fi
