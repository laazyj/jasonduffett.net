#!/usr/bin/env sh
# Pre-commit secret scan. Catches credentials before they leave the laptop;
# GitHub's server-side secret scanning is the second line of defence once the
# repo is public. See README.md "Pre-commit secret scan" for setup.

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found in PATH." >&2
  echo "Install it (e.g. \`brew install gitleaks\`) or skip with --no-verify." >&2
  exit 1
fi

gitleaks protect --staged --redact --no-banner --config .gitleaks.toml || exit 1

# GitHub Actions audit. Optional locally — the zizmor workflow enforces it in
# CI — so a missing binary skips rather than blocks. Only runs when the commit
# touches .github/, and offline so it needs no token and stays fast. See
# README.md "GitHub Actions audit" for setup.
if git diff --cached --name-only --diff-filter=ACMR | grep -q '^\.github/'; then
  if command -v zizmor >/dev/null 2>&1; then
    zizmor --offline --no-progress .github/
  else
    echo "pre-commit: zizmor not found in PATH; skipping Actions audit (\`brew install zizmor\`)." >&2
  fi
fi
