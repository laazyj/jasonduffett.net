{
  "name": "jasonduffett-net",
  "description": "Monorepo for jasonduffett.net — infrastructure (CDK) and blog site.",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"packages/**/*.css\"",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
    "lint:js:fix": "eslint --fix .",
    "lint:css:fix": "stylelint --fix \"packages/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:update": "nx run-many -t test:update",
    "build": "nx run-many -t build",
    "clean": "nx run-many -t clean",
    "cdk:synth": "nx run @jasonduffett-net/cdk:synth",
    "cdk:diff": "nx run @jasonduffett-net/cdk:diff",
    "cdk:deploy": "nx run @jasonduffett-net/cdk:deploy",
    "cdk:deploy:stack": "nx run @jasonduffett-net/cdk:deploy:stack",
    "indexnow:ping": "nx run @jasonduffett-net/cdk:indexnow:ping",
    "site:smoke": "nx run @jasonduffett-net/cdk:smoke",
    "site:check-redirects": "nx run @jasonduffett-net/cdk:check:redirects",
    "site:build": "nx run @jasonduffett-net/site:build",
    "site:start": "nx run @jasonduffett-net/site:start",
    "site:clean": "nx run @jasonduffett-net/site:clean",
    "clara:build": "nx run @jasonduffett-net/clara:build",
    "clara:start": "nx run @jasonduffett-net/clara:start",
    "clara:clean": "nx run @jasonduffett-net/clara:clean",
    "verify": "npm run format:check && npm run build && npm run lint && npm run test",
    "prepare": "husky"
  },
  "author": "Jason Duffett",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@nx/js": "23.1.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "nx": "23.1.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
