{#
  The index. A real <table> — pillars are columns, levels are rows — so
  screen readers and keyboard users get proper row/column semantics.

  Rendered from `matrix`, the checked view of `model/naomi.json` (see
  `_data/matrix.js`). There is exactly ONE copy of every cell's content, in
  the cell. Density is a presentation concern: the stylesheet decides how
  much of it shows at a given width, and expanding re-lays the affected row
  so the open cell gets the full width, rather than duplicating the copy
  into a separate detail panel.

  The density ladder is media queries in assets/matrix.css and only ever
  subtracts, so it needs no JavaScript and prints in full.
#}
<div class="m-wrap">
  <div class="m-scroll">
    <table class="m">
      <caption class="visually-hidden">
        {{ site.fullTitle }}: {{ matrix.pillars.length }} pillars across
        {{ matrix.levels.length }} maturity levels, from
        {{ matrix.levels[0].ordinalLabel }} down to
        {{ matrix.levels[matrix.levels.length - 1].ordinalLabel }}.
        Each cell can be expanded for its full description.
      </caption>
      <thead>
        <tr>
          <th scope="col" class="m-corner">
            <span class="m-corner-axis">pillars &rarr;</span>
            <span class="m-corner-axis">levels &darr;</span>
          </th>
          {% for p in matrix.pillars %}
          <th scope="col" class="m-col">
            <button type="button" class="m-col-btn" data-col="{{ p.id }}" aria-expanded="false">
              <span class="m-col-name">{{ p.name }}</span>
              <span class="m-col-abbr" aria-hidden="true">{{ p.abbr }}</span>
              <span class="m-col-def">{{ p.promise }}</span>
            </button>
          </th>
          {% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for lv in matrix.levels %}
        <tr
            class="m-row{% if lv.remedial %} m-row--remedial{% endif %}"
            data-level="{{ lv.id }}"
            style="--m-accent: var({{ lv.accent }})"
          >
          <th scope="row" class="m-rail">
            <button type="button" class="m-rail-btn" data-row="{{ lv.id }}" aria-expanded="false">
              <span class="m-num">{{ lv.ordinalLabel }}</span>
              <span class="m-assurance">{{ lv.assurance }}</span>
              <span class="m-lead"><strong>{{ lv.lead }}</strong> {{ lv.rest }}</span>
              <span class="m-ent">
                <span class="m-ent-label">you may delegate</span>
                {{ lv.entitlement }}
              </span>
            </button>
          </th>
          {% for p in matrix.pillars %}
          <td class="m-cell" data-pillar="{{ p.id }}">
            {#
              The behaviours sit beside the button rather than inside it:
              text inside a button cannot be selected, and this is a table
              people quote from. The button is the cell's control — focus,
              keyboard, aria-expanded, the deep-link target — and wraps only
              the level accent. The click surface is the whole cell, which is
              matrix.js's business, so no behaviour is a better target than
              any other whichever element it happens to sit in.

              The description stays pointed at the text at every rung, including
              the narrow ones where the stylesheet hides it: the density ladder
              is about what there is room to show, and a screen reader has room
              for all of it.
            #}
            <button
              type="button"
              class="m-cell-btn"
              id="cell-{{ p.id }}-{{ lv.id }}"
              data-cell="{{ p.id }}"
              data-level="{{ lv.id }}"
              aria-expanded="false"
              aria-describedby="text-{{ p.id }}-{{ lv.id }}"
            >
              <span class="visually-hidden m-sr">{{ p.name }}, level {{ lv.ordinalLabel }}</span>
            </button>
            <div class="m-text" id="text-{{ p.id }}-{{ lv.id }}">
              {% for text in matrix.cells[lv.id + "." + p.id] %}
              <p class="m-point">{{ text }}</p>
              {% endfor %}
            </div>
          </td>
          {% endfor %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
