{
  "name": "@jasonduffett-net/naomi",
  "version": "1.0.0",
  "private": true,
  "description": "Native AI Operational Maturity Index subsite (naomi.jasonduffett.net) — Eleventy.",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "eleventy",
    "start": "eleventy --serve --quiet"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "default",
          "^default",
          {
            "env": "NAOMI_GA_MEASUREMENT_ID"
          },
          {
            "env": "GITHUB_SHA"
          }
        ]
      },
      "start": {
        "cache": false
      }
    }
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6"
  }
}
