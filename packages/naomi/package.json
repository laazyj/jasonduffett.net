{
  "name": "@jasonduffett-net/naomi",
  "version": "1.0.0",
  "private": true,
  "description": "Native AI Operational Maturity Index subsite (naomi.jasonduffett.net) — Eleventy.",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "eleventy",
    "start": "eleventy --serve --quiet",
    "pdf": "node scripts/build-sheet.mjs",
    "test": "vitest run"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "default",
          "^default",
          {
            "env": "NAOMI_GA_MEASUREMENT_ID"
          },
          {
            "env": "GITHUB_SHA"
          }
        ]
      },
      "start": {
        "cache": false
      },
      "pdf": {
        "dependsOn": [
          "build"
        ],
        "cache": false
      },
      "test": {
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "pdfjs-dist": "^6.3.289",
    "vitest": "^5.0.0"
  }
}
