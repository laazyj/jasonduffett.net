  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{% if title %}{{ title }} — {{ headTitle or site.title }}{% else %}{{ headTitle or site.title }} — {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{{ summary or site.description }}" />
  <meta http-equiv="content-language" content="{{ site.language }}" />
  <meta name="author" content="{{ site.author.name }}" />
  <meta name="theme-color" content="#0f0d0c" />
  <meta name="build-sha" content="{{ build.sha }}" />
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
  {% if showLicense %}
  <link rel="license" href="{{ site.defaultLicense }}" />
  <meta name="copyright" content="© {{ currentYear }} {{ site.author.name }}, {{ site.licenseName }}" />
  <meta name="tdm-reservation" content="0" />
  <meta name="tdm-policy" content="{{ site.url }}{{ site.licensePolicyUrl }}" />
  {% endif %}
  {% if headIcon %}<link rel="icon" href="{{ headIcon | rel }}" type="image/svg+xml" />{% else %}<link rel="icon" href="{{ '/favicon.ico' | rel }}" sizes="32x32" />
  <link rel="icon" href="{{ '/favicon.svg' | rel }}" type="image/svg+xml" />{% endif %}
  <link rel="apple-touch-icon" href="{{ '/apple-touch-icon.png' | rel }}" />
  <link rel="manifest" href="{{ '/site.webmanifest' | rel }}" />
  <link rel="stylesheet" href="{{ (headSheet or '/assets/styles.css') | rel }}" />
  <link rel="alternate" type="application/rss+xml" href="{{ (headFeed or '/feed.xml') | rel }}" title="{{ headTitle or site.title }}" />
  {% set isPost = layout == 'layouts/post.njk' or layout == 'layouts/labs-post.njk' %}
  {% set ogImageUrl = site.url + (ogImage if ogImage else ('/og/' + page.fileSlug + '.png' if isPost else site.defaultOgImage)) %}
  <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.title }}{% endif %}" />
  <meta property="og:description" content="{{ summary or site.description }}" />
  <meta property="og:type" content="{% if isPost %}article{% else %}website{% endif %}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:site_name" content="{{ headTitle or site.title }}" />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:image" content="{{ ogImageUrl }}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{% if title %}{{ title }}{% else %}{{ headTitle or site.title }}{% endif %}" />
  <meta name="twitter:description" content="{{ summary or site.description }}" />
  <meta name="twitter:image" content="{{ ogImageUrl }}" />
  {% if isPost %}
  <meta property="article:published_time" content="{{ page.date | htmlDateString }}" />
  <meta property="article:author" content="{{ site.author.name }}" />
  {% include "partials/jsonld-post.njk" %}
  {% else %}
  {% include "partials/jsonld-site.njk" %}
  {% endif %}
  {% include "partials/analytics.njk" %}
